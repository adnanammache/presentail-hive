{
  "name": "presentail-hive",
  "version": "0.1.0",
  "private": true,
  "description": "Presentail Hive — mission control for AI agents: tasks, recurring workflows and chat.",
  "type": "module",
  "engines": {
    "node": ">=22.5 <23"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"node --watch --disable-warning=ExperimentalWarning server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production node --disable-warning=ExperimentalWarning server/index.js",
    "seed": "node --disable-warning=ExperimentalWarning server/seed.js --force",
    "test": "node --disable-warning=ExperimentalWarning --test server/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@resvg/resvg-js": "^2.6.2",
    "croner": "^10.0.1",
    "express": "^5.2.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "vite": "^8.3.1"
  }
}
